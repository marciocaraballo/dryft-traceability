{
  "name": "dryft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:changed": "git diff --name-only --diff-filter=ACMR HEAD | grep -E '\\.(tsx?|jsx?)$' | xargs eslint",
    "lint:changed:fix": "git diff --name-only --diff-filter=ACMR HEAD | grep -E '\\.(tsx?|jsx?)$' | xargs eslint --fix",
    "type-check": "tsc --noEmit",
    "type-check:changed": "tsc --noEmit",
    "prettier:changed:fix": "git diff --name-only --diff-filter=ACMR HEAD | grep -E '\\.(tsx?|jsx?|css|json|md)$' | xargs prettier --write",
    "test": "jest --passWithNoTests",
    "test:changed": "jest --onlyChanged --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
